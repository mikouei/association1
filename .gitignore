# Node
node_modules/
**/node_modules/

# Databases runtime (SQLite legacy)
backend/prisma/*.db

# Environment files - NEVER commit real .env files
.env
*.env
*.env.*
!*.env.example
frontend/.env
backend/.env

# Logs
*.log

