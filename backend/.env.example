# AssocManager Backend Environment Variables
# Copy this file to .env and fill in the real values

# JWT Secret - MUST be changed in production (use a long random string)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Server port
PORT=8001

# Node environment
NODE_ENV=development

# PostgreSQL Database URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://user:password@localhost:5432/assocmanager"
